# CloudCuyo Migration Lab
# Local on-premise simulation with VirtualBox + Vagrant.
# Run from this directory: cd vagrant && vagrant up

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.box_check_update = false

  config.vm.provider "virtualbox" do |vb|
    vb.linked_clone = true if Vagrant::Util::Platform.windows?
  end

  config.vm.define "lb01" do |node|
    node.vm.hostname = "lb01"
    node.vm.network "private_network", ip: "192.168.56.10"
    node.vm.provider "virtualbox" do |vb|
      vb.name = "cloudcuyo-lb01"
      vb.memory = 512
      vb.cpus = 1
    end
    node.vm.provision "shell", path: "../scripts/local/setup-lb.sh"
  end

  config.vm.define "frontend01" do |node|
    node.vm.hostname = "frontend01"
    node.vm.network "private_network", ip: "192.168.56.20"
    node.vm.synced_folder "../app/frontend", "/vagrant_app/frontend"
    node.vm.provider "virtualbox" do |vb|
      vb.name = "cloudcuyo-frontend01"
      vb.memory = 512
      vb.cpus = 1
    end
    node.vm.provision "shell", path: "../scripts/local/setup-frontend.sh"
  end

  config.vm.define "frontend02" do |node|
    node.vm.hostname = "frontend02"
    node.vm.network "private_network", ip: "192.168.56.21"
    node.vm.synced_folder "../app/frontend", "/vagrant_app/frontend"
    node.vm.provider "virtualbox" do |vb|
      vb.name = "cloudcuyo-frontend02"
      vb.memory = 512
      vb.cpus = 1
    end
    node.vm.provision "shell", path: "../scripts/local/setup-frontend.sh"
  end

  config.vm.define "api01" do |node|
    node.vm.hostname = "api01"
    node.vm.network "private_network", ip: "192.168.56.30"
    node.vm.synced_folder "../app/api", "/vagrant_app/api"
    node.vm.provider "virtualbox" do |vb|
      vb.name = "cloudcuyo-api01"
      vb.memory = 768
      vb.cpus = 1
    end
    node.vm.provision "shell", path: "../scripts/local/setup-api.sh"
  end

  config.vm.define "db01" do |node|
    node.vm.hostname = "db01"
    node.vm.network "private_network", ip: "192.168.56.40"
    node.vm.synced_folder "../database", "/vagrant_db"
    node.vm.provider "virtualbox" do |vb|
      vb.name = "cloudcuyo-db01"
      vb.memory = 768
      vb.cpus = 1
    end
    node.vm.provision "shell", path: "../scripts/local/setup-db.sh"
  end
end
